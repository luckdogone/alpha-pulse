# Active model provider. DeepSeek uses its official Anthropic-compatible API.
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_EFFORT=high

# Optional Claude configuration, used only with MODEL_PROVIDER=claude / --engine claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# Optional outbound proxy. Values loaded from .env are passed explicitly to REST/WSS clients.
# Environment variables override .env; lower/upper-case forms are both accepted.
HTTP_PROXY=http://127.0.0.1:13659
HTTPS_PROXY=http://127.0.0.1:13659
ALL_PROXY=socks5://127.0.0.1:13659
# Optional Binance-only override; otherwise HTTPS_PROXY > HTTP_PROXY > ALL_PROXY.
BINANCE_PROXY=

# Binance USD-M futures public market data (no API key required).
BINANCE_REST_BASE_URL=https://fapi.binance.com
# Current Binance market-stream path; legacy fallback is opt-in only.
BINANCE_WS_URL_TEMPLATE=wss://fstream.binance.com/market/ws/{symbol}@kline_{interval}
BINANCE_WS_FALLBACK_URL_TEMPLATE=

# Optional paid CoinGlass V4 integration.
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_EXCHANGES=Binance,OKX,Bybit

# Optional generic on-chain JSON adapter. Placeholders: {symbol}, {base_asset}.
ONCHAIN_URL_TEMPLATE=
ONCHAIN_API_KEY=

SNAPSHOT_MINUTES=30
INDICATOR_WARMUP_CANDLES=250
ANALYSIS_VALIDITY_MINUTES=30
# Empty uses the packaged, editable default_decision_tree.json.
DECISION_TREE_PATH=
REQUEST_TIMEOUT_SECONDS=10

ANTHROPIC_BASE_URL=https://api.anthropic.com
# Claude Opus 5/Fable 5 server-side refusal fallback; actual model is recorded in trace.jsonl.
ANTHROPIC_FALLBACKS=true
MODEL_TIMEOUT_SECONDS=90
ANALYSIS_TIMEOUT_SECONDS=180
MAX_AGENT_ROUNDS=6
MAX_TOOL_CALLS=16
CONTEXT_MAX_BYTES=48000
ARTIFACTS_DIR=runs
NEWS_DOMAINS=reuters.com,apnews.com,bloomberg.com,ft.com,bbc.com,coindesk.com
